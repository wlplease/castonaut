# Optional local node origin. Leave blank to relay local development through
# Castonaut's hosted proxy; setting this sends requests from your computer.
SNAPCHAIN_URL=
SNAPCHAIN_PROXY_URL=https://castonaut.vercel.app/api/snapchain

# Optional server-side Gemini digest. Never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional GIPHY search key. GIPHY requires browser-side Search API requests,
# so this provider key is public in the built app. Restrict/manage it in GIPHY.
VITE_GIPHY_API_KEY=

# Public contract address compiled into the client. Safe to expose; never put a secret here.
VITE_PASS_CONTRACT_ADDRESS=

# Free public access for the contest/tutorial build. Paid builds can omit this
# and configure a verified pass contract above.
VITE_CONTEST_ACCESS=false

# Optional: local generation of short, static station voice clips.
# Keep these values in .env; never prefix them with VITE_ or commit the file.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MAE=
ELEVENLABS_VOICE_QUINN=
ELEVENLABS_VOICE_JULES=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional; only use with an HTTPS endpoint that has a separate Basic Auth proxy.
# SNAPCHAIN_HTTP_USER=
# SNAPCHAIN_HTTP_PASS=

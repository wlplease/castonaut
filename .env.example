# Optional local node origin. Leave blank to relay local development through
# Castonaut's hosted proxy; setting this sends requests from your computer.
SNAPCHAIN_URL=
SNAPCHAIN_PROXY_URL=https://castonaut.vercel.app/api/snapchain

# Optional hosted GIF search (no key entry for users). GIPHY requires client-side search,
# so this app-owned key is delivered to browsers; do not treat it as a secret.
# Keep Upstash credentials server-only and use an HTTPS Upstash Redis REST endpoint.
# GIPHY_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Local preview uses the hosted shared limiter by default; change only for another deployment.
# GIPHY_PROXY_URL=https://castonaut.vercel.app/api/giphy


# Optional: local generation of short, static station voice clips.
# Keep these values in .env; never prefix them with VITE_ or commit the file.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MAE=
ELEVENLABS_VOICE_QUINN=
ELEVENLABS_VOICE_JULES=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional; only use with an HTTPS endpoint that has a separate Basic Auth proxy.
# SNAPCHAIN_HTTP_USER=
# SNAPCHAIN_HTTP_PASS=

{
  "name": "castonaut-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test",
    "audio:generate": "node --env-file-if-exists=.env scripts/generate-station-audio.mjs",
    "provision": "node scripts/provision-gcp.mjs",
    "node": "node scripts/start-node.mjs",
    "node:check": "node scripts/start-node.mjs --check",
    "node:status": "node scripts/node-status.mjs",
    "node:status:once": "node scripts/node-status.mjs --once",
    "client": "node scripts/client.mjs",
    "destroy": "node scripts/destroy-gcp.mjs"
  },
  "dependencies": {
    "@farcaster/core": "^0.20.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "buffer": "^6.0.3",
    "viem": "^2.57.7"
  },
  "overrides": {
    "@farcaster/core": {
      "@faker-js/faker": "10.5.0"
    },
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
